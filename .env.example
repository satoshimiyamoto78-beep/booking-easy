# Postgres connection string. On Vercel, connect the Vercel Postgres (Neon)
# integration and it will inject this automatically as POSTGRES_PRISMA_URL /
# DATABASE_URL depending on setup — copy the pooled URL here for local use.
DATABASE_URL="postgresql://user:password@localhost:5432/barbershop?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Seeded/admin login (used by prisma/seed.ts to create the first admin user)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"
