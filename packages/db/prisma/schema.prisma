// Prisma schema for the barbershop / spa / salon booking platform.
// Get a free hosted Postgres database in seconds: `npx create-db`
// Or point DATABASE_URL at a Vercel Postgres (Neon) instance.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceCategory {
  BARBER
  SPA
  SALON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionTier {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// One tenant on the platform. Absorbed the old singleton BusinessSettings,
// which was dropped once every row below was backfilled with a businessId.
model Business {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  address   String?
  phone     String?
  email     String?
  instagram String?

  // Customer-facing branding, shown on the public /[slug] booking site.
  brandColor String? @default("#0f9d70")
  logoUrl    String?

  dodoCustomerId       String?  @unique
  dodoSubscriptionId   String?  @unique
  dodoProductId        String?
  subscriptionTier     SubscriptionTier   @default(STARTER)
  subscriptionStatus   SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  // Platform-admin override, independent of subscriptionStatus (billing
  // truth) — for policy/abuse suspension regardless of payment state.
  suspended            Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins       AdminUser[]
  services     Service[]
  staff        Staff[]
  customers    Customer[]
  appointments Appointment[]
}

model Service {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        ServiceCategory
  durationMinutes Int
  priceCents      Int
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  imageUrl        String?
  staff           StaffService[]
  appointments    Appointment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([businessId, active])
}

model Staff {
  id           String          @id @default(cuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  title        String?
  bio          String?
  photoUrl     String?
  active       Boolean         @default(true)
  services     StaffService[]
  schedules    StaffSchedule[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([businessId, active])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// Recurring weekly availability window for a staff member.
model StaffSchedule {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startMinute Int // minutes after midnight, e.g. 540 = 9:00am
  endMinute   Int // minutes after midnight, e.g. 1080 = 6:00pm

  @@index([staffId, dayOfWeek])
}

// One-off blocks of unavailability (vacation, sick day, etc).
model TimeOff {
  id       String   @id @default(cuid())
  staffId  String
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([staffId, startsAt])
}

model Customer {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  // Unique per business, not globally — the same person can be a customer
  // at two different businesses as two separate rows.
  email        String
  phone        String?
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([businessId, email])
}

model Appointment {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  staffId    String
  staff      Staff             @relation(fields: [staffId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId, staffId, startsAt])
  @@index([customerId])
}

model AdminUser {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Globally unique — the single global /admin/login form resolves
  // email -> admin -> business with no slug in the URL to disambiguate.
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
}

// The founder's own login, not tenant-scoped — deliberately a separate
// model from AdminUser rather than a nullable-businessId reuse of it, so
// the two trust domains (shop owners vs. platform operator) can never be
// conflated in one query surface.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
